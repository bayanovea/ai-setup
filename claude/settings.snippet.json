{
  "_comment": "Merge into ~/.claude/settings.json. Hooks reference the symlinks install.sh creates.",
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agterm-idle-after-clear.sh\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/answer-style-reminder.sh\"",
            "timeout": 5,
            "statusMessage": "Reply-format reminder"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/sensitive-file-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Sensitive-file guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/no-claude-attribution.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/perf-review-session-end.sh\"",
            "timeout": 300,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agterm-name-reset-on-clear.sh\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "split-branch-for-review": "user-invocable-only"
  },
  "tui": "fullscreen",
  "viewMode": "focus"
}
